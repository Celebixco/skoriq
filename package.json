{
  "name": "sports-data-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-agnostic sports data analysis platform MVP.",
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "tsc -b",
    "dev:api": "npm run dev -w @sports-data/api",
    "dev:dashboard": "npm run dev -w @sports-data/dashboard",
    "dev:worker": "npm run dev -w @sports-data/worker",
    "dev:scheduler": "npm run dev -w @sports-data/scheduler",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/db-readiness.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:test:migrate": "tsx scripts/db-test-migrate.ts",
    "db:test:reset": "tsx scripts/db-test-reset.ts",
    "docker:test:down": "docker compose -f docker/local/compose.yml --profile test down",
    "docker:test:up": "docker compose -f docker/local/compose.yml --profile test up -d postgres-test",
    "lint": "eslint .",
    "analytics:football:team-form:build": "tsx scripts/analytics-football-team-form-build.ts",
    "analytics:football:h2h:build": "tsx scripts/analytics-football-h2h-build.ts",
    "analytics:football:match-prediction-features:build": "tsx scripts/analytics-football-match-prediction-features-build.ts",
    "analytics:football:prediction-candidates:generate": "tsx scripts/analytics-football-prediction-candidates-generate.ts",
    "analytics:football:prediction-drafts:rebuild-stale": "tsx scripts/analytics-football-prediction-drafts-rebuild-stale.ts",
    "analytics:football:predictions:settle": "tsx scripts/analytics-football-predictions-settle.ts",
    "analytics:football:public-eligibility:evaluate": "tsx scripts/analytics-football-public-eligibility-evaluate.ts",
    "analytics:football:reasoning:build": "tsx scripts/analytics-football-reasoning-build.ts",
    "analytics:football:match:view": "tsx scripts/analytics-football-match-view.ts",
    "analytics:football:list-targets": "tsx scripts/analytics-football-list-targets.ts",
    "pipeline:football:prematch": "tsx scripts/pipeline-football-prematch.ts",
    "auth:create-admin": "tsx scripts/auth-create-admin.ts",
    "provider:apifootball:auth:check": "tsx scripts/provider-apifootball-capture-samples.ts --auth-check",
    "provider:apifootball:backfill-history": "tsx scripts/provider-apifootball-backfill-history.ts",
    "provider:apifootball:capture:samples": "tsx scripts/provider-apifootball-capture-samples.ts",
    "provider:apifootball:h2h:evidence": "tsx scripts/provider-apifootball-h2h-evidence.ts",
    "provider:apifootball:h2h:backfill-upcoming": "tsx scripts/provider-apifootball-h2h-backfill-upcoming.ts",
    "provider:apifootball:h2h:ingest": "tsx scripts/provider-apifootball-h2h-ingest.ts",
    "provider:apifootball:ingest:manual": "tsx scripts/provider-apifootball-manual-ingest.ts",
    "provider:raw-payload:reprocess": "tsx scripts/provider-raw-payload-reprocess.ts",
    "test": "vitest run",
    "test:integration": "npm run db:test:reset && npm run db:test:migrate && vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=22"
  }
}
