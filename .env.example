NODE_ENV=development
LOG_LEVEL=info

API_PORT=3000
WORKER_CONCURRENCY=3
SCHEDULER_TICK_CRON=*/15 * * * *
CLEANUP_CRON=0 3 * * *
MOCK_PROVIDER_ENABLED=false

DATABASE_URL=postgres://postgres:postgres@localhost:5432/sports_data
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:55432/sports_data_test
REDIS_URL=redis://localhost:6379
DB_EXECUTION_TARGET=local
ALLOW_REMOTE_TEST_DB=false
NEON_BRANCH_NAME=

AUTH_ENABLED=true
AUTH_JWT_SECRET=replace-with-local-random-secret
AUTH_COOKIE_NAME=betify_auth
AUTH_TOKEN_TTL_SECONDS=86400

RAW_PAYLOAD_SUCCESS_RETENTION_DAYS=7
RAW_PAYLOAD_FAILED_RETENTION_DAYS=30
SYNC_LOG_RETENTION_DAYS=14

PROVIDER_DEFAULT_RATE_LIMIT_PER_MINUTE=60

APIFOOTBALL_COM_API_KEY=
APIFOOTBALL_COM_API_KEY_DEFAULT=
APIFOOTBALL_COM_API_KEY_COUNTRIES=
APIFOOTBALL_COM_API_KEY_LEAGUES=
APIFOOTBALL_COM_API_KEY_TEAMS=
APIFOOTBALL_COM_API_KEY_STANDINGS=
APIFOOTBALL_COM_API_KEY_EVENTS=
APIFOOTBALL_COM_API_KEY_RESULTS=
APIFOOTBALL_COM_API_KEY_FIXTURES=
APIFOOTBALL_COM_API_KEY_PLAYERS=
APIFOOTBALL_COM_API_KEY_STATISTICS=
APIFOOTBALL_COM_API_KEY_LINEUPS=
APIFOOTBALL_COM_API_KEY_INJURIES=
APIFOOTBALL_COM_BASE_URL=https://apiv3.apifootball.com/
APIFOOTBALL_COM_ENABLED=false
APIFOOTBALL_COM_TIMEOUT_MS=15000
